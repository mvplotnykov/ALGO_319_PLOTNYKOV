// Для заданого дійсного x знайти значення наступної функції u, що приймає
// значення цілого типу:
//         −x^2, якщо x ≤ 0;
// u(x) =   x, якщо 0 < x ≤ 3;
//          9 − x, якщо x > 3.

//--------- Завдання if_35 ---------
void tsk_if_35(){
    cout << "Завдання 1 - if_35\n";
    cout << "Вводьте значення для перевірки. Для виходу в головне меню введіть 'q'.\n";

    string input;
    double num1;
    
    while (true) {
        cout << "\nВведіть значення x (або 'q' для виходу) ---> ";
        cin >> input;
        
        //Перевірка натиск клав виходу(англ q || укр й)
        if (input == "q" || input == "Q" || input == "й" || input == "Й") {
            cout << "Повернення до головного меню...\n";
            break; // Перериває цикл
        }
        
        //перетвор тексту на дроб числ
        try {
            num1 = stod(input);
        } catch (...) {
            cout << "Помилка! Ви ввели не число. Спробуйте ще раз.\n";
            continue; // починає цикл заново
        }
        

        if (num1 <= 0) {
            cout << " Значення x <= 0  ==> u(x) = -x^2 = " << -(pow(num1, 2)) << endl;
        }   
        if (0 < num1 && num1 <= 3) {
            cout << " Значення 0 < x <= 3  ==> u(x) = x = " << num1 << endl;
        }
        if (num1 > 3) {
            cout << " Значення x > 3  ==> u(x) = 9 - x = " << 9 - num1 << endl; 
        }
    }
}

void tsk_fig_13(){
    cout << "Завдання 2 - Fig_13\n";
    double x, y, r;
    //блок введення
    cout << "Введіть значення радіусу (R) ---> ";
    cin >> r;
    cout << "\n Введіть значення х ---> ";
    cin >> x;
    cout << "Введіть значення y ---> ";
    cin >> y;
    //Розбиваємо умову на 2
    bool btm_lft = (pow(x + r, 2) + pow(y + r, 2) <= r * r) && (x >= -r) && (y <= -x - 2* 2);
    bool top_rgt = (pow(x - r, 2) + pow(y - r, 2) <= r * r) && (x >= r) && (y <= r) && (x + y <= 2*r);
    if (btm_lft || top_rgt){ //якщо обидві виконуються - то точка в області
        cout << "\nТочка належить темно-зеленій області" << endl;
    } else {
        cout << "\nТочка НЕ належить темно-зеленій області" << endl;
    }
}
